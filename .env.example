# Local, non-secret configuration. Copy to .env to override (the start scripts and the backend read it automatically).
# Local mode needs no API key. An Ollama cloud key is OPTIONAL and only used if you switch to cloud models in Settings -> AI models.

# Where the app listens. Keep 127.0.0.1 so nothing is exposed to your network.
APP_HOST=127.0.0.1
APP_PORT=3000

# Ollama must be on this machine (non-loopback URLs are refused unless ALLOW_NON_LOCAL_OLLAMA=1).
OLLAMA_HOST_URL=http://127.0.0.1:11434

# Optional: Ollama cloud models (https://ollama.com/settings/keys). Leave empty to stay fully local.
# If set here it takes precedence over a key saved in Settings and nothing is stored in the database.
# Never commit a real key (.env is git-ignored).
OLLAMA_API_KEY=
# OLLAMA_CLOUD_URL=https://ollama.com   # must be https (http only for a loopback test server)

# 1 (default): start.sh starts Ollama for you when it is installed but not running. 0: leave Ollama alone (you manage it yourself, or you are testing the first-run setup page).
# OLLAMA_AUTOSTART=1

# Models
LLM_MODEL=qwen3.5:4b
TTS_MODEL=phonon
# Which voice speaks the questions:
#   auto    Phonon when it is installed (Apple Silicon Macs only), otherwise your computer's own offline voices
#   phonon  Phonon only (Apple Silicon Macs)
#   system  always use your computer's offline voices (Windows, Linux, Intel Macs)
TTS_PROVIDER=auto
STT_MODEL=base.en        # Whisper size for the optional microphone feature: tiny.en | base.en | small.en
STT_ENABLED=1

# LLM tuning for a computer with 8 GB of RAM
LLM_NUM_CTX=6144         # context window; lower = less RAM
LLM_MAX_TOKENS=1400      # cap on one evaluation's output
LLM_TEMPERATURE=0.2
LLM_KEEP_ALIVE=10m       # how long Ollama keeps the model in RAM after the last request
LLM_UNLOAD_WHEN_IDLE=1   # 1 = free the model's ~4 GB as soon as no interview is running (pause / finish / end). 0 = keep it for LLM_KEEP_ALIVE
LLM_TIMEOUT_S=240        # hard cap per evaluation
LLM_IDLE_TIMEOUT_S=90    # abort if the model emits nothing for this long

# Speech / storage
TTS_TIMEOUT_S=60
AUDIO_CACHE_MB=200       # generated question audio is cached under data/audio_cache
# DATA_DIR=data

# Resumes (Resumes page). Uploaded PDFs are kept in data/resumes (file mode 600); copying the data folder copies them.
RESUME_MAX_MB=10         # largest PDF accepted
RESUME_MAX_PAGES=15      # longest PDF accepted
OCR_ENABLED=1            # 1 = read scanned (image-only) pages with Tesseract when it is installed; 0 = never
OCR_LANGS=eng            # Tesseract languages, e.g. eng or eng+deu (each must be installed in Tesseract)
# Optional full path to the tesseract program, only if it is not found automatically (leave empty otherwise):
TESSERACT_CMD=
